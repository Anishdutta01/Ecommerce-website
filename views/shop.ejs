<%- include('../partials/header') %>
            
    <!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shop</title>
    <style>
        /* Global styling */
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f4f4f9;
            color: #333;
        }

        h1 {
            text-align: center;
            color: #333;
        }

        a {
            text-decoration: none;
            color: #007BFF;
        }

        a:hover {
            color: #0056b3;
        }

        /* Success message styling */
        .success-message {
            text-align: center;
            color: green;
            margin: 20px;
            padding: 10px;
            border: 2px solid green;
            border-radius: 5px;
            background-color: #e8f7e8;
        }

        /* Filter dropdown styling */
        .filter-container {
            display: flex;
            justify-content: center;
            margin: 20px;
        }

        .filter-container select {
            padding: 10px;
            font-size: 1rem;
            border-radius: 5px;
            border: 1px solid #ccc;
            background-color: #fff;
        }

        /* Product container styling */
        .product-container {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-evenly;
            margin: 20px;
        }

        .product {
            background-color: white;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            width: 280px;
            margin: 15px;
            overflow: hidden;
            transition: transform 0.3s ease;
        }

        .product img {
            width: 100%;
            height: auto;
            border-bottom: 2px solid #f4f4f9;
        }
        .product img:hover{
            width: 100%;
            transform: scale(1.5);
            
        }

        .product-info {
            padding: 15px;
        }

        .product-info h3 {
            font-size: 1.2rem;
            color: #333;
        }

        .product-info pre {
            font-size: 1rem;
            color: #666;
        }

        .product-info a {
            display: inline-block;
            background-color: #28a745;
            color: white;
            padding: 5px;
            border-radius: 5px;
            margin-top: 10px;
            text-align: center;
            width: 100%;
            height: 25px;
            left: 50%;
        }

        .product-info a:hover {
            background-color: #218838;
        }

        .product:hover {
            transform: translateY(-5px);
        }

        .reviews {
            margin-top: 10px;
            background-color: #f9f9f9;
            padding: 10px;
            border-radius: 5px;
        }

        .reviews h4 {
            font-size: 1rem;
            color: #333;
            margin-bottom: 10px;
        }

        .review-item {
            background-color: #fff;
            padding: 10px;
            margin-bottom: 8px;
            border: 1px solid #ddd;
            border-radius: 5px;
        }

        .review-item h3 {
            margin: 0;
            font-size: 1rem;
            color: #555;
        }

        .review-item p {
            margin: 5px 0;
            font-size: 0.9rem;
            color: #777;
        }

        /* Mobile responsiveness */
        @media (max-width: 768px) {
            .product-container {
                flex-direction: column;
                align-items: center;
            }

            .product {
                width: 90%;
            }
        }
    </style>
</head>
<body>
    <!-- Success message -->
    <div class="success-message" style="text-align: center; margin-top: 10px;">
        <% if(success.length > 0) { %>
            <%= success %>
        <% } %>
    </div>

    <!-- Filter dropdown -->
    <div class="filter-container">
        <select name="filter" id="" onchange="window.location.href=this.value">
            <option value="">Select filter</option>
            <option value="localhost/3000/shop/<%= 0 %>">Price</option>
            <option value="localhost/3000/shop/<%= 1 %>">Recently added</option>
        </select>
    </div>

    <!-- Products list -->
    <div class="product-container">
        <% products.forEach(function(product) { %>
            <div class="product">
                <img src="data:image/jpeg;base64,<%= product.image.toString('base64') %>" alt="<%= product.name %>">
                <div class="product-info">
                    <h3>Name: <%= product.name %></h3>
                    <pre>Price: <%= product.price %></pre>   
                    <pre>Discount: <%= product.discount %></pre>
                    <pre>Total price: <%= product.price - product.discount %></pre>
                    <a href="/Addtocart/<%= product._id %>">Add to cart</a>

                    <div class="reviews">
                        <h4>Reviews</h4>
                        <% product.reviews.forEach(function(review) { %>
                            <div class="review-item">
                                <h3><%= Object.keys(review)[0] %>:</h3>
                                <p><%= Object.values(review)[0] %></p>
                            </div>
                        <% }) %>
                    </div>
                </div>
            </div>
        <% }) %>
    </div>

</body>
</html>

<%- include('../partials/footer')%>