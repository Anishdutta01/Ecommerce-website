
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cart</title>
    <style>
        /* Global styling */
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f4f4f9;
            color: #333;
        }

        h1 {
            text-align: center;
            color: #333;
            margin-top: 30px;
        }

        a {
            text-decoration: none;
            color: #007BFF;
        }

        a:hover {
            color: #0056b3;
        }

        /* Success message styling */
        .success-message {
            text-align: center;
            color: green;
            margin: 20px;
            padding: 10px;
            border: 2px solid green;
            border-radius: 5px;
            background-color: #e8f7e8;
        }

        /* Cart item styling */
        .cart-container {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            margin: 20px;
        }

        .cart-item {
            background-color: white;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            width: 280px;
            margin: 15px;
            overflow: hidden;
            transition: transform 0.3s ease;
            padding: 15px;
        }

        .cart-item img {
            width: 100%;
            height: auto;
            border-bottom: 2px solid #f4f4f9;
        }

        .cart-item-info {
            padding-top: 15px;
        }

        .cart-item-info h3 {
            font-size: 1.2rem;
            color: #333;
        }

        .cart-item-info pre {
            font-size: 1rem;
            color: #666;
            margin: 5px 0;
        }

        .cart-item-info a {
            display: inline-block;
            background-color: #28a745;
            color: white;
            padding: 10px;
            border-radius: 5px;
            margin-top: 10px;
            text-align: center;
            width: 100%;
        }

        .cart-item-info a:hover {
            background-color: #218838;
        }

        .cart-item:hover {
            transform: translateY(-5px);
        }

        /* Mobile responsiveness */
        @media (max-width: 768px) {
            .cart-container {
                flex-direction: column;
                align-items: center;
            }

            .cart-item {
                width: 90%;
            }
        }
    </style>
</head>
<body>
    <!-- Success message -->
    <div class="success-message">
        <% if(success.length > 0) { %>
            <%= success %>
        <% } %>
    </div>

    <h1>Your Cart</h1>

    <!-- Cart items -->
    <div class="cart-container">
        <%if(user1.cart.length < 0) {%>
            <h1>Please add something to your Cart</h1>
        <%} else{%>
            <% user1.cart.reverse().forEach(function(product) { %>
                <div class="cart-item">
                    <img src="data:image/jpeg;base64,<%= product.image.toString('base64') %>" alt="<%= product.name %>">
                    <div class="cart-item-info">
                        <h3>Name: <%= product.name %></h3>
                        <pre>Price: <%= product.price %>    Discount: <%= product.discount %></pre>
                        <pre>Total price: <%= product.price - product.discount %></pre>
                        <a href="#">BUY</a>
                        <a href="/review/<%= product._id %>">Add review</a>
                    </div>
                </div>
            <% }) %>
            <%} %>
    </div>

</body>
</html>
